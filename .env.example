# Copy this file to .env. Never commit the tunnel credentials JSON.
CLOUDFLARED_CONFIG_FILE=./deploy/cloudflare/config.yml
CLOUDFLARED_CREDENTIALS_FILE=/home/your-user/.cloudflared/REPLACE_WITH_TAOCI_TUNNEL_UUID.json
# Match the owner of the credentials JSON (`id -u` and `id -g`).
CLOUDFLARED_USER=1000:1000

# Cross-origin development clients only. Production browser traffic is same-origin.
TAOCI_ALLOWED_ORIGINS=http://localhost:5173

# Optional bind-mount overrides. Defaults preserve the existing local data.
TAOCI_CONFIG_DIR=./backend/config
TAOCI_DATA_DIR=./backend/data

# Shared Unix socket on the WSL Linux filesystem. DrvFS (/mnt/c) cannot host it.
# Use /tmp/taoci-codex-<id -u>; the backend container runs as UID 1000 by default.
TAOCI_CODEX_SOCKET_DIR=/tmp/taoci-codex-1000

# Shared Pi SDK Worker socket. Keep this on the WSL Linux filesystem too.
TAOCI_PI_SOCKET_DIR=/tmp/taoci-pi-1000
TAOCI_PI_CONCURRENCY=4
