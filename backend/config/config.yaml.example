# ========================
# 套磁 Agent 系统 - 主配置
# ========================
# 使用前请复制此文件为 config.yaml 并填入真实信息:
#   cp config.yaml.example config.yaml

# LLM 配置
llm:
  # 可选: codex, openai, deepseek, ollama
  provider: "codex"
  # Codex App Server 配置；复用宿主机 codex login，不需要 API Key
  codex:
    # 留空则使用 Codex 账号当前默认模型
    model: ""
    timeout_seconds: 600
  # OpenAI 配置
  openai:
    api_key: "your-openai-api-key"
    model: "gpt-4o"
    base_url: "https://api.openai.com/v1"
  # DeepSeek 配置
  deepseek:
    api_key: "your-deepseek-api-key"
    model: "deepseek-chat"
    base_url: "https://api.deepseek.com/v1"
  # Ollama 本地模型配置
  ollama:
    model: "llama3"
    base_url: "http://localhost:11434"

# 搜索配置
search:
  # auto 跟随全局 LLM：Codex 使用专用 harness，其他后端使用 Serper 工具链
  # 也可显式设为 codex 或 serper；全局 LLM 为 Codex 时始终使用 Codex harness
  provider: "auto"
  codex:
    # 单次 Codex 搜索超时；Worker 在宿主机运行，不读取此文件中的 API Key
    timeout_seconds: 900
    # Codex Worker 不可用时是否回退到旧版 Serper Search Agent
    fallback_to_serper: false
  # 仅供 Serper provider 或显式回退使用 (https://serper.dev)
  serper_api_key: "your-serper-api-key"
  # 研究方向关键词
  keywords:
    - "machine learning"
    - "natural language processing"
  # 目标地区偏好
  regions:
    - "US"
    - "UK"
    - "China"
  # 单次搜索最大导师数量
  max_professors: 20

# SMTP 发件配置
smtp:
  host: "smtp.gmail.com"
  port: 587
  username: "your_email@gmail.com"
  password: "your-app-password"
  use_tls: true

# IMAP 收件配置（用于回复跟踪）
imap:
  host: "imap.gmail.com"
  port: 993
  username: "your_email@gmail.com"
  password: "your-app-password"
  use_ssl: true
  # 轮询间隔（秒）
  poll_interval: 300

# Agent 行为自定义（可选，留空使用默认行为）
prompts:
  # 搜索偏好：告诉搜索 Agent 你想找什么样的导师
  search_preference: ""
  # 中文邮件风格
  compose_style_cn: ""
  # 英文邮件风格
  compose_style_en: ""
  # 中文邮件额外要求
  compose_extra_cn: ""
  # 英文邮件额外要求
  compose_extra_en: ""
